name: Create Sub Issues and Link to Parent

on:
  workflow_dispatch:
    inputs:
      parent_issue_number:
        description: '親Issueの番号'
        required: true
        type: number

jobs:
  create_sub_issues:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout (必要に応じて)
        uses: actions/checkout@v3

      - name: Create sub-issues and link
        uses: actions/github-script@v7
        with:
          github-token: ${{ secrets.GH_TOKEN }}
          script: |
            const parentNumber = inputs.parent_issue_number;
            const owner = context.repo.owner;
            const repo = context.repo.repo;

            // 親Issueを取得
            const parent = await github.rest.issues.get({
              owner,
              repo,
              issue_number: parentNumber,
            });

            const parentBody = parent.data.body;
            const parentNodeId = parent.data.node_id;

            // チェックリスト項目を抽出
            const checklistItems = parentBody.match(/- \[ \] (.+)/g) || [];

            for (const item of checklistItems) {
              const title = item.replace(/- \[ \] /, '').trim();

              // 子Issueを作成
              const child = await github.rest.issues.create({
                owner,
                repo,
                title: title,
                body: `This issue is part of #${parentNumber}`,
              });

              const childNodeId = child.data.node_id;

              // GraphQLで親子リンク（Tracks）を追加
              await github.graphql(`
                mutation {
                  addLinkedIssue(input: {
                    subjectId: "${parentNodeId}",
                    linkedIssueId: "${childNodeId}",
                    relationshipType: TRACKS
                  }) {
                    clientMutationId
                  }
                }
              `);
            }
