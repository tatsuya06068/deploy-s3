name: Create Sub-Issues by Repository

on:
  issue_comment:
    types: [created]

jobs:
  create_sub_issues:
    if: github.event.comment.body == '/create-subissues'
    runs-on: ubuntu-latest
    steps:
      - name: Create sub-issues
        uses: actions/github-script@v6
        with:
          github-token: ${{ secrets.PERSONAL_ACCESS_TOKEN }}
          script: |
            const parentIssue = context.payload.issue;
            const body = parentIssue.body || '';

            const lines = body.split('\n');
            let currentRepo = null;
            let repoChecklistMap = {};

            for (const line of lines) {
              const repoMatch = line.match(/^- \[ \] ([\w-]+\/[\w-]+)/);
              if (repoMatch) {
                currentRepo = repoMatch[1];
                repoChecklistMap[currentRepo] = [];
              } else {
                const childMatch = line.match(/^\s*- \[ \] (.+)/);
                if (childMatch && currentRepo) {
                  repoChecklistMap[currentRepo].push(childMatch[1].trim());
                }
              }
            }

            for (const [repoFull, items] of Object.entries(repoChecklistMap)) {
              const [owner, repo] = repoFull.split('/');
              for (const title of items) {
                const childIssue = await github.rest.issues.create({
                  owner,
                  repo,
                  title,
                  body: `Created from parent issue: [#${parentIssue.number}](${parentIssue.html_url})`
                });

                await github.rest.issues.createComment({
                  owner: context.repo.owner,
                  repo: context.repo.repo,
                  issue_number: parentIssue.number,
                  body: `✅ Created issue in \`${repoFull}\`: [#${childIssue.data.number}](${childIssue.data.html_url}) - ${title}`
                });
              }
            }
